# Copy this file to backend/config/.env and fill in real values.
# The real .env is gitignored and must NEVER be committed.
# On the server, create this file manually (it is not deployed via git).

# Environment: "production" (default; hides errors from users) or "development" (shows them).
APP_ENV=production

DB_HOST=localhost
DB_NAME=asclepius_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Cloud SQL: managed providers often use a custom port and require TLS.
# DB_PORT=3306
# DB_SSL_CA=/absolute/path/to/ca.pem
