# Block direct web access to backend internals (config/.env, db schema, lib, auth).
# These are included server-side via PHP and must never be fetched over HTTP.
# Only backend/api/ is reachable — it re-grants access in backend/api/.htaccess.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
