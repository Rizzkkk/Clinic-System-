# Secrets - never commit real credentials
.env
backend/config/.env
*.local.php

# Uploaded files (bytes live on disk; the DB stores only the path)
storage/xray/
storage/signatures/

# Composer. There are no PHP dependencies today, so the lock file would only
# be noise; if a real dependency is ever added, start tracking composer.lock.
/vendor/
composer.lock

# Scratch output from smoke tests and local runs
*.log
cookies.txt

# OS / editor noise
Thumbs.db
.DS_Store
*.swp
.idea/
.vscode/

# Private to the working machine - deliberately not on the public repo.
# These carry deployment topology, the security findings list, and QA account
# passwords. Removed from GitHub in 2681b8e/34ee163/2ab2412/23928fe; listed here
# so they cannot be committed back by accident.
/docs/
/CLAUDE.md
/CHANGELOG.md
/.claude/

# Landing page (React/Vite source merged from the landing-page branch).
# The app is not built or served today - index.php remains the public site -
# but the source tree is kept so the design can be ported from it.
node_modules/
dist/
dist-ssr/
*.local
